<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!-- background stars -->

    <GlobalWorldDrawLayerDef>
        <defName>Astra_BackgroundStars</defName>
        <worldDrawLayer>Astralum.Astronomy.BackgroundStars.GlobalDrawLayer_BackgroundStars</worldDrawLayer>
        <modExtensions>
            <li Class="Astralum.Astronomy.BackgroundStars.ModExt_BackgroundStars">
                <starCount>5000~60000</starCount>
                <starSizeRange>0.085~0.85</starSizeRange>
                <galacticPlaneBounds>-0.13~0.13</galacticPlaneBounds>
            </li>
        </modExtensions>
    </GlobalWorldDrawLayerDef>
    
    <!-- local stars -->

    <GlobalWorldDrawLayerDef>
        <defName>Astra_LocalStars</defName>
        <worldDrawLayer>Astralum.Astronomy.LocalStars.GlobalDrawLayer_LocalStars</worldDrawLayer>
    </GlobalWorldDrawLayerDef>
    
    <!-- nebulae -->

    <GlobalWorldDrawLayerDef>
        <defName>Astra_Nebulae</defName>
        <worldDrawLayer>Astralum.Astronomy.Nebulae.GlobalDrawLayer_Nebulae</worldDrawLayer>
        <modExtensions>
            <li Class="Astralum.Astronomy.Nebulae.ModExt_Nebulae">
                <nebulaCount>0~50</nebulaCount>
                <nebulaSizeRange>4~14</nebulaSizeRange>
                <galacticPlaneBounds>-0.18~0.18</galacticPlaneBounds>
            </li>
        </modExtensions>
    </GlobalWorldDrawLayerDef>

    <!-- constellations -->
    
    <GlobalWorldDrawLayerDef>
        <defName>Astra_Constellations</defName>
        <worldDrawLayer>Astralum.Astronomy.Constellations.GlobalDrawLayer_Constellations</worldDrawLayer>
        <modExtensions>
            <li Class="Astralum.Astronomy.Constellations.ModExt_Constellations">
                <constellationCount>13</constellationCount>
                <maxPlacementAttempts>80</maxPlacementAttempts>
                <constellationSizeMin>3.1</constellationSizeMin>
                <constellationSizeMax>3.5</constellationSizeMax>
                <minViewRotationAngle>160</minViewRotationAngle>
                <maxViewRotationAngle>200</maxViewRotationAngle>
            </li>
        </modExtensions>
    </GlobalWorldDrawLayerDef>

    <!-- constellation stars -->

    <GlobalWorldDrawLayerDef>
        <defName>Astra_ConstellationStars</defName>
        <worldDrawLayer>Astralum.Astronomy.Constellations.GlobalDrawLayer_ConstellationStars</worldDrawLayer>
        <modExtensions>
            <li Class="Astralum.Astronomy.Constellations.ModExt_ConstellationStars">
                <baseStarSize>0.25</baseStarSize>
                <brightStarSize>0.85</brightStarSize>
            </li>
        </modExtensions>
    </GlobalWorldDrawLayerDef>

    <!-- shooting stars -->

    <GlobalWorldDrawLayerDef>
        <defName>Astra_ShootingStars</defName>
        <worldDrawLayer>Astralum.Astronomy.ShootingStars.GlobalDrawLayer_ShootingStars</worldDrawLayer>
        <modExtensions>
            <li Class="Astralum.Astronomy.ShootingStars.ModExt_ShootingStars">
                <mTBIntervalSeconds>25</mTBIntervalSeconds>
                <lifetime>0.45~2.875</lifetime>
                <travelDistance>5.0~65.0</travelDistance>
                <length>0.5~2.1</length>
                <width>0.035~0.085</width>
                <galacticPlaneBounds>-0.5~0.5</galacticPlaneBounds>
            </li>
        </modExtensions>
    </GlobalWorldDrawLayerDef>

    <!-- coordinate grid -->
    
    <GlobalWorldDrawLayerDef>
        <defName>Astra_SkyCoordinateGrid</defName>
        <worldDrawLayer>Astralum.Astronomy.SkyGrid.GlobalDrawLayer_SkyCoordinateGrid</worldDrawLayer>
    </GlobalWorldDrawLayerDef>

    <!-- pulsars -->

    <GlobalWorldDrawLayerDef>
        <defName>Astra_Pulsars</defName>
        <worldDrawLayer>Astralum.Astronomy.Pulsars.GlobalDrawLayer_Pulsars</worldDrawLayer>
        <modExtensions>
            <li Class="Astralum.Astronomy.Pulsars.ModExt_Pulsars">
                <pulsarChance>0.025</pulsarChance>
                <pulsarSize>0.1~0.45</pulsarSize>
                <pulsarCount>1~3</pulsarCount>
            </li>
        </modExtensions>
    </GlobalWorldDrawLayerDef>

    <!-- black holes -->

    <GlobalWorldDrawLayerDef>
        <defName>Astra_BlackHoles</defName>
        <worldDrawLayer>Astralum.Astronomy.BlackHoles.GlobalDrawLayer_BlackHoles</worldDrawLayer>
        <modExtensions>
            <li Class="Astralum.Astronomy.BlackHoles.ModExt_BlackHoles">
                <galacticPlaneBounds>-0.75~0.75</galacticPlaneBounds>
                <blackHoleChance>0.025</blackHoleChance>
                <blackHoleSize>0.05~0.7</blackHoleSize>
                <blackHoleCount>1~3</blackHoleCount>
            </li>
        </modExtensions>
    </GlobalWorldDrawLayerDef>

    <!-- dust lanes -->

    <GlobalWorldDrawLayerDef>
        <defName>Astra_GalacticDustLanes</defName>
        <worldDrawLayer>Astralum.Astronomy.GalacticDustLanes.GlobalDrawLayer_GalacticDustLanes</worldDrawLayer>
        <modExtensions>
            <li Class="Astralum.Astronomy.GalacticDustLanes.ModExt_GalacticDustLanes">
                <dustLaneCount>4~20</dustLaneCount>
                <dustLaneSizeRange>6~32</dustLaneSizeRange>
                <galacticPlaneBounds>0.05~0.05</galacticPlaneBounds>
            </li>
        </modExtensions>
    </GlobalWorldDrawLayerDef>

</Defs>