  <!-- MOD SETTINGS (celestial rendering) -->
  <Astra_RenderBackgroundsStars>Render Overhauled Background Stars</Astra_RenderBackgroundsStars>
  <Astra_RenderBackgroundsStarsDesc>Renders many, many, MANY more procedurally generated background stars in the world
    view, replacing the vanilla background stars.
  </Astra_RenderBackgroundsStarsDesc>

  <Astra_RenderNebulae>Render Nebulae</Astra_RenderNebulae>
  <Astra_RenderNebulaeDesc>Renders procedurally generated nebulae throughout the world view.</Astra_RenderNebulaeDesc>

  <Astra_RenderConstellations>Render Constellations</Astra_RenderConstellations>
  <Astra_RenderConstellationsDesc>Renders procedurally generated constellations and their stars in the world view,
    including their associated interactions.
  </Astra_RenderConstellationsDesc>

  <Astra_RenderBlackholes>Render Black Holes</Astra_RenderBlackholes>
  <Astra_RenderBlackholesDesc>Renders procedurally generated black holes in the world view. Black holes are extremely
    rare, though multiple may occasionally exist at once.
  </Astra_RenderBlackholesDesc>

  <Astra_RenderPulsars>Render Pulsars</Astra_RenderPulsars>
  <Astra_RenderPulsarsDesc>Renders procedurally generated pulsars in the world view. Pulsars are extremely rare.
  </Astra_RenderPulsarsDesc>

  <Astra_RenderShootingStars>Render Shooting Stars</Astra_RenderShootingStars>
  <Astra_RenderShootingStarsDesc>Renders intermittent shooting stars across the world view.
  </Astra_RenderShootingStarsDesc>

  <Astra_RenderWorldAuroras>Render World Auroras</Astra_RenderWorldAuroras>
  <Astra_RenderWorldAurorasDesc>Renders auroras above the planet's polar regions in the world view while an aurora is
    active
  </Astra_RenderWorldAurorasDesc>

  <!-- MOD SETTINGS (local stars) -->
  <Astra_OverrideVanillaSun>Override Vanilla Sun</Astra_OverrideVanillaSun>
  <Astra_OverrideVanillaSunDesc>Replaces the vanilla sun with up to three procedurally generated local stars system
    using realistic, randomized stellar properties. Systems may contain main-sequence stars of any spectral class: O, B,
    A, F, G, K, or M.
  </Astra_OverrideVanillaSunDesc>

  <!-- MOD SETTINGS (local map lighting) -->
  <Astra_AllowLocalStarLighting>Allow Local Star Lighting</Astra_AllowLocalStarLighting>
  <Astra_AllowLocalStarLightingDesc>Allows local maps to use the combined light colors of the planet's host star or
    stars.\n\nDisabling this setting also disables local star eclipses and local starlight map glow
    calculations.\n\nChanges take effect within 2,000 ticks.
  </Astra_AllowLocalStarLightingDesc>

  <Astra_AllowLocalStarLightForMapGlow>Allow Local Starlight For Map Glow</Astra_AllowLocalStarLightForMapGlow>
  <Astra_AllowLocalStarLightForMapGlowDesc>Allows the intensity of local starlight to affect map glow—the actual light
    level experienced by map cells, such as "Brightly Lit (100%)."\n\nChanges take effect within 2,000 ticks.
  </Astra_AllowLocalStarLightForMapGlowDesc>

  <!-- MOD SETTINGS (camera) -->
  <Astra_CameraPanEasing>Camera Focus Easing</Astra_CameraPanEasing>
  <Astra_CameraPanEasingDesc>Controls the easing curve used when the world-view camera focuses on a celestial object.
  </Astra_CameraPanEasingDesc>

  <Astra_CameraPanAnimationDuration>Camera Pan Animation Duration</Astra_CameraPanAnimationDuration>
  <Astra_CameraPanAnimationDurationDesc>Controls how long it takes for the camera to pan from one celestial object to
    another.
  </Astra_CameraPanAnimationDurationDesc>

  <Astra_CameraPanEasing_Linear>Linear</Astra_CameraPanEasing_Linear>
